rules_version = '2';

// ===========================================================================
// AppEntreno · reglas de Firestore
//
// Todo lo tuyo cuelga de users/{uid}, asi que la regla es una sola: solo el
// dueno entra. Eso sustituye a la politica por tabla que haria falta en SQL.
//
// El catalogo de 1.324 ejercicios no esta aqui a proposito: es igual para
// todos y cada movil se lo descarga del JSON. Solo suben los ejercicios que
// creas tu y los del catalogo que hayas editado.
//
// Social no abre nada de eso. Cada uno publica aparte un resumen de lo suyo
// (perfil, posts y rangos) y solo sus amigos pueden leerlo.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function esElDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function amistad(a, b) {
      return /databases/$(database)/documents/friendships/$(a + '_' + b);
    }

    // Solo cuenta una amistad aceptada: una solicitud sin contestar no da
    // acceso a nada. El documento puede estar en cualquiera de los dos
    // sentidos, segun quien la pidiera.
    function aceptada(a, b) {
      return exists(amistad(a, b)) && get(amistad(a, b)).data.status == 'aceptada';
    }

    function sonAmigos(otro) {
      return request.auth != null
        && (aceptada(request.auth.uid, otro) || aceptada(otro, request.auth.uid));
    }

    // Un enlace a una foto, o nada. Las fotos subidas no caben aqui a proposito.
    function esEnlace(valor) {
      return valor == null
        || (valor is string && valor.size() <= 2048 && valor.matches('https?://.+'));
    }

    function esNombre(valor) {
      return valor == null || (valor is string && valor.size() <= 60);
    }

    // ---------------------------------------------------------------------
    // Tus datos: entrenos, rutinas, medidas, ajustes...
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if esElDueno(uid);

      match /{coleccion}/{documento} {
        allow read, write: if esElDueno(uid);
      }

      // Posts de Social: un resumen de cada entreno terminado. Los escribe el
      // dueno con la regla de arriba; aqui solo se abre la lectura a sus amigos.
      match /posts/{postId} {
        allow read: if sonAmigos(uid);
      }
    }

    // ---------------------------------------------------------------------
    // Perfil publico: nombre, enlace de la foto y codigo de amigo.
    //
    // Se puede abrir el de alguien cuyo uid conoces (por su codigo, o porque
    // ya es tu amigo), pero no listarlos: nadie puede recorrer quien usa la app.
    // ---------------------------------------------------------------------
    match /profiles/{uid} {
      allow get: if request.auth != null;
      allow create, update: if esElDueno(uid)
        && request.resource.data.uid == uid
        && esNombre(request.resource.data.get('displayName', null))
        && esEnlace(request.resource.data.get('avatarUrl', null));
      allow delete: if esElDueno(uid);
    }

    // ---------------------------------------------------------------------
    // Codigos de amigo: de quien es cada uno.
    //
    // Se consultan de uno en uno, nunca en lista, y una vez creados no se
    // tocan: crear uno que ya existe seria actualizarlo, y eso esta cerrado.
    // ---------------------------------------------------------------------
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[2-9A-HJKMNP-Z]{8}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
    }

    // ---------------------------------------------------------------------
    // Resumen para comparar estadisticas.
    //
    // En Firestore no hay JOIN: leer los entrenos crudos de un amigo seria
    // caro y expondria de mas. Cada uno publica aqui unas pocas cifras ya
    // calculadas, y solo las ven sus amigos.
    // ---------------------------------------------------------------------
    match /publicStats/{uid} {
      allow read: if esElDueno(uid) || sonAmigos(uid);
      allow write: if esElDueno(uid);
    }

    // ---------------------------------------------------------------------
    // Rutinas compartidas. Se copian, no se enlazan: si el autor la cambia
    // manana, la tuya no se mueve.
    // ---------------------------------------------------------------------
    match /sharedRoutines/{id} {
      allow read: if request.auth != null && (
        resource.data.visibility == 'publica'
        || esElDueno(resource.data.ownerId)
        || (resource.data.visibility == 'amigos' && sonAmigos(resource.data.ownerId))
      );
      allow create: if esElDueno(request.resource.data.ownerId);
      allow update, delete: if esElDueno(resource.data.ownerId);
    }

    // ---------------------------------------------------------------------
    // Amistades. El id es "solicitante_destinatario", asi no hay duplicados.
    // ---------------------------------------------------------------------
    match /friendships/{id} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.requesterId
        || request.auth.uid == resource.data.addresseeId
      );

      // Se pide en tu nombre, a otra persona, y nace pendiente. Si el otro ya
      // te la habia pedido a ti, no se crea la inversa: lo que toca es aceptarla.
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.addresseeId is string
        && request.resource.data.addresseeId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.addresseeId
        && request.resource.data.status == 'pendiente'
        && request.resource.data.keys().hasOnly(['requesterId', 'addresseeId', 'status', 'createdAt', 'acceptedAt'])
        && !exists(amistad(request.resource.data.addresseeId, request.auth.uid));

      // Aceptar es cosa del destinatario, y solo cambia el estado y la fecha.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.addresseeId
        && resource.data.status == 'pendiente'
        && request.resource.data.status == 'aceptada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      // Rechazar, cancelar o dejar de ser amigos es borrarla, y vale cualquiera de los dos.
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.requesterId
        || request.auth.uid == resource.data.addresseeId
      );
    }

    // Todo lo que no este contemplado arriba, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
