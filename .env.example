# Credenciales de Firebase. Copia este fichero a .env y rellena los valores.
# Se sacan de la consola: Configuracion del proyecto -> Tus apps -> app web.
#
# Sin esto la app funciona igual, pero en modo local: sin cuentas y sin
# sincronizacion entre dispositivos.
#
# La apiKey no es un secreto en Firebase, solo identifica el proyecto. Lo que
# protege los datos son las reglas de firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=appentreno-31a7d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=appentreno-31a7d
VITE_FIREBASE_STORAGE_BUCKET=appentreno-31a7d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
